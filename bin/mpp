#!/usr/bin/env bash
# mpp — markdown pipeline
# Routes documents to the right converter:
#   .docx → pandoc
#   .pdf  → marker_single
#
# Usage:
#   mpp <input> [-o <output>] [-r|--recursive]
#
# If <input> is a file, it is converted to a single .md.
# If <input> is a directory, all compatible files inside are converted.
# With --recursive, subdirectories are scanned too (and the input tree is
# mirrored under the output directory).
#
# Default output directory is ./markdown_out/ (per global convention).

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: mpp <input> [-o <output>] [-r|--recursive]

Convert documents to Markdown.
  .docx → pandoc
  .pdf  → marker_single

Options:
  -o, --output <path>   Output file or directory (default: ./markdown_out/)
  -r, --recursive       Recurse into subdirectories
  -h, --help            Show this help

Examples:
  mpp resume.docx                          # → ./markdown_out/resume.md
  mpp paper.pdf -o ./out/                  # → ./out/paper.md
  mpp ./docs -o ./md --recursive           # mirrors tree
EOF
}

INPUT=""
OUTPUT=""
RECURSIVE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--output)
            [[ $# -ge 2 ]] || { echo "mpp: -o requires a value" >&2; exit 2; }
            OUTPUT="$2"
            shift 2
            ;;
        -r|--recursive)
            RECURSIVE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "mpp: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if [[ -z "$INPUT" ]]; then
                INPUT="$1"
            else
                echo "mpp: only one input path is supported" >&2
                exit 2
            fi
            shift
            ;;
    esac
done

if [[ -z "$INPUT" ]]; then
    usage >&2
    exit 2
fi

if [[ ! -e "$INPUT" ]]; then
    echo "mpp: input not found: $INPUT" >&2
    exit 1
fi

OUTPUT="${OUTPUT:-./markdown_out}"

# Required tools
for tool in pandoc marker_single; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "mpp: '$tool' not found on PATH" >&2
        exit 127
    fi
done

# Convert one file. Args: <input file> <target dir>
# marker_single creates a subdirectory named after the input stem and writes
# multiple files into it; we flatten that down to a single .md in target_dir.
convert_file() {
    local in="$1"
    local target_dir="$2"

    local base stem ext
    base="$(basename "$in")"
    stem="${base%.*}"
    ext="$(printf '%s' "${base##*.}" | tr '[:upper:]' '[:lower:]')"

    mkdir -p "$target_dir"

    case "$ext" in
        docx)
            printf '[pandoc] %s → %s/%s.md\n' "$in" "$target_dir" "$stem"
            pandoc "$in" -o "$target_dir/$stem.md"
            ;;
        pdf)
            printf '[marker] %s → %s/%s.md\n' "$in" "$target_dir" "$stem"
            local tmpdir
            tmpdir="$(mktemp -d)"
            marker_single "$in" \
                --output_dir "$tmpdir" \
                --output_format markdown \
                --disable_image_extraction >/dev/null
            # Marker writes to <tmpdir>/<stem>/<stem>.md and possibly other files
            if [[ -f "$tmpdir/$stem/$stem.md" ]]; then
                mv "$tmpdir/$stem/$stem.md" "$target_dir/$stem.md"
            else
                # Fall back: find any .md produced
                local produced
                produced="$(find "$tmpdir" -type f -name '*.md' | head -1)"
                if [[ -n "$produced" ]]; then
                    mv "$produced" "$target_dir/$stem.md"
                else
                    echo "mpp: marker produced no markdown for $in" >&2
                    rm -rf "$tmpdir"
                    return 1
                fi
            fi
            rm -rf "$tmpdir"
            ;;
        *)
            echo "mpp: skipping unsupported file: $in" >&2
            return 0
            ;;
    esac
}

# Single-file mode
if [[ -f "$INPUT" ]]; then
    # If OUTPUT looks like a file (has .md extension), write to that exact path.
    # Otherwise treat OUTPUT as a directory.
    if [[ "$OUTPUT" == *.md ]]; then
        target_dir="$(dirname "$OUTPUT")"
        target_name="$(basename "$OUTPUT" .md)"
        # Convert to a temp dir with the desired stem so naming aligns
        tmp="$(mktemp -d)"
        ext="$(printf '%s' "${INPUT##*.}" | tr '[:upper:]' '[:lower:]')"
        cp "$INPUT" "$tmp/$target_name.$ext"
        convert_file "$tmp/$target_name.$ext" "$target_dir"
        rm -rf "$tmp"
    else
        convert_file "$INPUT" "$OUTPUT"
    fi
    exit 0
fi

# Directory mode
if [[ -d "$INPUT" ]]; then
    # Strip trailing slash for consistent relative-path math
    INPUT="${INPUT%/}"

    if [[ "$RECURSIVE" -eq 1 ]]; then
        find_args=(-type f)
    else
        find_args=(-maxdepth 1 -type f)
    fi

    found_any=0
    while IFS= read -r -d '' file; do
        found_any=1
        rel="${file#"$INPUT"/}"
        rel_dir="$(dirname "$rel")"
        if [[ "$rel_dir" == "." ]]; then
            target_dir="$OUTPUT"
        else
            target_dir="$OUTPUT/$rel_dir"
        fi
        convert_file "$file" "$target_dir"
    done < <(
        find "$INPUT" "${find_args[@]}" \
            \( -iname '*.docx' -o -iname '*.pdf' \) \
            -print0
    )

    if [[ "$found_any" -eq 0 ]]; then
        echo "mpp: no .docx or .pdf files found in $INPUT" >&2
        exit 1
    fi
    exit 0
fi

echo "mpp: input must be a file or directory: $INPUT" >&2
exit 1
